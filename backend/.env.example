# =====================================================================
# backend 설정 예시. 이 파일을 복사해서 .env 를 만든다:  copy .env.example .env
# .env 는 PC 마다 다를 수 있고 비밀 값이 들어갈 수 있어서 git 에 올리지 않는다 (.gitignore)
# 항목을 추가하면 app/config.py 의 Settings 에도 같은 이름으로 추가해야 한다 (테스트가 검사함)
# =====================================================================

# ---- 서버 ----
APP_NAME="Document OCR"
# 프론트 주소. 여러 개면 ["http://localhost:5173","http://127.0.0.1:5173"] 처럼 JSON 배열로
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# ---- 경로 (backend 폴더 기준 상대 경로) ----
STORAGE_DIR=./storage
DB_PATH=./data/app.db
LOG_DIR=./logs

# ---- 로그 ----
LOG_LEVEL=INFO
LOG_BACKUP_DAYS=14

# ---- 업로드 제한 ----
MAX_FILE_SIZE_MB=5
MAX_PAGES=10

# ---- 처리 시간 / 워커 ----
# 파일 하나(1~3단계 전체) 제한 시간(초). 이 PC(CPU) 기준 스캔 페이지 1장 ≈ 4~6초
PROCESS_TIMEOUT_SEC=30
# 동시에 처리할 파일 수. 워커 1개당 메모리 약 1.5GB
WORKER_COUNT=1
# 모델 로딩 대기 최대 시간(초). 첫 실행은 모델 다운로드 때문에 오래 걸린다
WORKER_START_TIMEOUT_SEC=600

# ---- OCR 판정 ----
# confidence 가 이 값보다 낮으면 "추출 실패"
OCR_CONFIDENCE_THRESHOLD=0.8
# 블록 점수 계산: mean(글자 수 가중 평균) | min(가장 낮은 줄)
OCR_CONFIDENCE_AGG=mean
TABLE_STRUCTURE_THRESHOLD=0.5

# ---- 전처리 ----
PDF_RENDER_DPI=200
PDF_TEXT_LAYER_MIN_CHARS=20
CROP_PADDING_PX=12

# ---- 모델 (PaddleOCR 3.x 모델 이름) ----
LAYOUT_MODEL=PP-DocLayout_plus-L
LAYOUT_THRESHOLD=0.5
TEXT_DET_MODEL=PP-OCRv5_mobile_det
TEXT_REC_MODEL_KO=korean_PP-OCRv5_mobile_rec
TEXT_REC_MODEL_EN=en_PP-OCRv5_mobile_rec
TABLE_MODEL=SLANet_plus
PADDLE_DISABLE_MODEL_SOURCE_CHECK=true

# ---- 결과 합치기 ----
# DB 에 저장하는 .txt 에 --- page N --- 구분선을 넣을지
MERGE_PAGE_SEPARATOR=true
