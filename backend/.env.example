# =====================================================================
# backend 설정 예시. 이 파일을 복사해서 .env 를 만든다:  copy .env.example .env
# .env 는 PC 마다 다를 수 있고 비밀 값이 들어갈 수 있어서 git 에 올리지 않는다 (.gitignore)
# 항목을 추가하면 app/config.py 의 Settings 에도 같은 이름으로 추가해야 한다 (테스트가 검사함)
# =====================================================================

# ---- 서버 ----
APP_NAME="Document OCR"
# 프론트 주소. 여러 개면 ["http://localhost:5173","http://127.0.0.1:5173"] 처럼 JSON 배열로
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# ---- 경로 (backend 폴더 기준 상대 경로) ----
STORAGE_DIR=./storage
DB_PATH=./data/app.db
LOG_DIR=./logs

# ---- 로그 ----
LOG_LEVEL=INFO
LOG_BACKUP_DAYS=14

# ---- 업로드 제한 ----
MAX_FILE_SIZE_MB=20
MAX_PAGES=20

# ---- 처리 시간 / 워커 ----
# 파일 하나(1~3단계 전체) 제한 시간(초). 이 PC(CPU) 기준 스캔 페이지 1장 ≈ 4~6초
PROCESS_TIMEOUT_SEC=120
# 동시에 처리할 파일 수. 워커 1개당 메모리 약 1.5GB
WORKER_COUNT=1
# 모델 로딩 대기 최대 시간(초). 첫 실행은 모델 다운로드 때문에 오래 걸린다
WORKER_START_TIMEOUT_SEC=600

# ---- OCR 판정 ----
# confidence 가 이 값보다 낮으면 "추출 실패"
OCR_CONFIDENCE_THRESHOLD=0.8
# 블록 점수 계산: mean(글자 수 가중 평균) | min(가장 낮은 줄)
OCR_CONFIDENCE_AGG=mean
TABLE_STRUCTURE_THRESHOLD=0.5
# 표 칸이 기준 미달이면 [추출 실패] 대신 "읽은 글자 (?)" 로 보여 줄지
TABLE_SHOW_UNCERTAIN_TEXT=true
# 레이아웃 블록 밖의 글자(예: 영상 자막)를 페이지 전체에서 다시 찾아 글자 블록으로 추가할지
LAYOUT_SWEEP_UNCOVERED_TEXT=true
# 그중 페이지 높이의 이 비율보다 작은 글자는 버린다 (표로 묶이는 글자는 예외)
LAYOUT_SWEEP_MIN_HEIGHT_RATIO=0.03

# ---- 전처리 ----
PDF_RENDER_DPI=200
PDF_TEXT_LAYER_MIN_CHARS=20
CROP_PADDING_PX=12

# ---- 모델 (PaddleOCR 3.x 모델 이름) ----
LAYOUT_MODEL=PP-DocLayout_plus-L
LAYOUT_THRESHOLD=0.5
TEXT_DET_MODEL=PP-OCRv5_mobile_det
TEXT_DET_BOX_THRESH=0.3
TEXT_DET_UNCLIP_RATIO=2.0
TEXT_REC_MODEL_KO=korean_PP-OCRv5_mobile_rec
TEXT_REC_MODEL_EN=en_PP-OCRv5_mobile_rec
TABLE_MODEL=SLANet_plus
PADDLE_DISABLE_MODEL_SOURCE_CHECK=true

# ---- 결과 합치기 ----
# DB 에 저장하는 .txt 에 --- page N --- 구분선을 넣을지
MERGE_PAGE_SEPARATOR=true
# 이미지·PDF 의 머리말·꼬리말·쪽번호 블록을 .txt/.md 에서 뺄지 (화면에는 보임)
MERGE_SKIP_PAGE_FURNITURE=true

# ---- LLM 도우미 (Ollama) — 요약·오타 교정 제안 ----
# false 이거나 Ollama 가 꺼져 있어도 OCR 은 그대로 동작한다
LLM_ENABLED=true
OLLAMA_URL=http://localhost:11434
# ollama list 로 설치된 모델 확인. 없으면: ollama pull gemma4:e4b
OLLAMA_MODEL=gemma4:e4b
# 요청 하나 최대 대기 시간(초). 첫 요청은 모델 로딩 때문에 오래 걸린다
OLLAMA_TIMEOUT_SEC=300
# 긴 문서를 나눠 보낼 글자 수
LLM_CHUNK_CHARS=2500
# 교정 제안: 틀린 부분과 고친 글자가 이 비율 이상 닮아야 받아 준다 (엉뚱한 단어로 바꾸는 것 방지)
LLM_CORRECTION_MIN_SIMILARITY=0.6
