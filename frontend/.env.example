# =====================================================================
# frontend 설정 예시. 복사해서 .env 를 만든다:  copy .env.example .env
# Vite 는 이름이 VITE_ 로 시작하는 값만 브라우저 코드(import.meta.env)에 넘겨준다
# (그래서 비밀 값은 절대 여기 넣으면 안 된다 — 브라우저에서 누구나 볼 수 있다)
# =====================================================================

# backend API 주소
VITE_API_URL=http://localhost:8000/api

# 업로드 전에 브라우저에서 먼저 검사할 최대 파일 크기(MB). backend 의 MAX_FILE_SIZE_MB 와 같게 맞춘다
VITE_MAX_FILE_SIZE_MB=5

# 진행 상태를 몇 ms 마다 물어볼지
VITE_STATUS_POLL_MS=1000

# 서버 준비 상태(health)를 몇 ms 마다 확인할지
VITE_HEALTH_POLL_MS=3000

# 개발 서버 포트 (vite.config.js 에서 사용)
VITE_DEV_PORT=5173
